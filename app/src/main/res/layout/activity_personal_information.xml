<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- Language Selector -->
        <LinearLayout
            android:id="@+id/layoutLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_label"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@color/gold"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Brand Header -->
        <LinearLayout
            android:id="@+id/layoutBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutLanguage">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/gold"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:contentDescription="@string/accessibility_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_subtitle"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:alpha="0.8"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Personal Info Heading -->
        <TextView
            android:id="@+id/tvPersonalInfoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_personal_info"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBrand" />

        <!-- Verification Cards Container -->
        <LinearLayout
            android:id="@+id/layoutUploadCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:weightSum="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPersonalInfoTitle">

            <!-- Upload ID Card -->
            <LinearLayout
                android:id="@+id/cardUploadId"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/accessibility_id_upload">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/error_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_upload_id"
                    android:textColor="@color/primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Photo of Face Card -->
            <LinearLayout
                android:id="@+id/cardFacePhoto"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/accessibility_face_upload">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/error_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_photo_face"
                    android:textColor="@color/primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PIN Inputs Container -->
        <LinearLayout
            android:id="@+id/layoutPinForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutUploadCards">

            <!-- PIN Input -->
            <EditText
                android:id="@+id/etPersonalInfoPin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_enter_pin"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="16dp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"
                android:autofillHints="password" />

            <!-- Confirm PIN Input -->
            <EditText
                android:id="@+id/etPersonalInfoConfirmPin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_confirm_pin"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="16dp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="15sp"
                android:layout_marginBottom="28dp"
                android:autofillHints="password" />

            <!-- Proceed Button -->
            <Button
                android:id="@+id/btnPersonalInfoProceed"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_gold_button"
                android:text="@string/btn_proceed"
                android:textColor="@color/navy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
